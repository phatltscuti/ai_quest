 "sentences": [
  {
   "text": "Xin chào!",
   "start": 0.1,
   "end": 1.626
  },
  {
   "text": "Mình là Rồng Đỏ, linh vật của Scuti AI.",
   "start": 1.576,
   "end": 5.399
  },
  {
   "text": "Ở Scuti, các kỹ sư Việt Nam kết hợp cùng trí tuệ nhân tạo để xây dựng phần mềm nhanh hơn và thông minh hơn.",
   "start": 5.399,
   "end": 11.649
  },
  {
   "text": "Từ AI agent, tự động hóa quy trình, đến ứng dụng web và di động, chúng mình đồng hành cùng bạn từ ý tưởng đến sản phẩm.",
   "start": 11.649,
   "end": 19.365
  },
  {
   "text": "Ngay cả video này cũng được làm bằng AI: giọng nói tổng hợp, hoạt hình viết bằng code, và ghép tiếng bằng ffmpeg.",
   "start": 19.365,
   "end": 26.492
  },
  {
   "text": "Bạn đang có ý tưởng?",
   "start": 26.492,
   "end": 28.56
  },
  {
   "text": "Hãy cùng Scuti AI biến nó thành hiện thực nhé!",
   "start": 28.56,
   "end": 31.937
  }
 ],
